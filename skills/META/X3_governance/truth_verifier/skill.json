{
  "manifest_version": "1.0",
  "agent_id": "ccos-truth-verifier-v1",
  "name": "Truth Verifier",
  "description": "Cross-checks any claim against multiple authoritative sources, on-chain oracles, and decentralized consensus. Returns cryptographically attested trust score with full provenance. Zero tolerance for bad data.",
  "version": "1.0.0",
  "owner": "crystal-clear-os",
  "category": "verifiable-truth",

  "pricing": {
    "model": "per_verification",
    "base_price": "0.0008",
    "currency": "ETH",
    "hitl_fee": "0.002"
  },

  "capabilities": [
    "claim_verification",
    "multi_source_cross_check",
    "on_chain_oracle_query",
    "zk_proof_generation",
    "graph_rag_aggregation",
    "anomaly_detection",
    "source_reputation_scoring"
  ],

  "input_schema": {
    "type": "object",
    "properties": {
      "claim": { "type": "string" },
      "context": { "type": "string" },
      "required_sources": {
        "type": "array",
        "items": { "type": "string" },
        "default": []
      }
    },
    "required": ["claim"]
  },

  "output_schema": {
    "type": "object",
    "properties": {
      "trust_score": { "type": "number", "minimum": 0, "maximum": 100 },
      "verdict": {
        "type": "string",
        "enum": ["verified", "partially_verified", "disputed", "false"]
      },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "provenance": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": { "type": "string" },
            "timestamp": { "type": "string" },
            "data": { "type": "string" },
            "zk_proof": { "type": "string" }
          }
        }
      },
      "hitl_required": { "type": "boolean" },
      "audit_log_hash": { "type": "string" }
    },
    "required": [
      "trust_score",
      "verdict",
      "confidence",
      "provenance",
      "hitl_required"
    ]
  },

  "permissions": {
    "read_only": true,
    "allowed_apis": ["on_chain_oracles", "graph_rag", "source_reputation_db"],
    "max_latency_ms": 2400,
    "hitl_gate_threshold": 75
  },

  "dependencies": [
    "ccos-graph-rag-core",
    "ccos-zk-verifier",
    "ccos-source-reputation-db"
  ],

  "reputation_weight": 0.92,

  "hitl_config": {
    "enabled": true,
    "triggers": ["trust_score < 75", "sources_conflict", "high_stakes_claim"]
  }
}
